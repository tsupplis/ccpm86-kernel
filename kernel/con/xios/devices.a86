; Devices XIOS module: assemble this file to one object.
                        include mode.inc
xcode                   cseg    byte public 'CODE'
xdata                   dseg    para public 'CODE'
xios                    group   xcode,xdata
xdata                   dseg    para public 'CODE'
datastart               rb      0
                        include shared.inc

                        include devif.inc

                        include xdiskirq.lib
                        include xdevice.lib
                        include xfloppy.lib
                        include xdiskraw.lib
                        include xhard.lib

; GENDEF uses the same placement names as the CP/M BIOS, with contiguous
; 17-byte Concurrent DPBs here. No fixed-address ABI field lies in this area.
xdata                   dseg    para public 'CODE'
FD160                   equ     (offset $-offset datastart)
FD320                   equ     FD160+17
FDTABLES                equ     FD320+17
                        include pcdisks.lib

                        end
