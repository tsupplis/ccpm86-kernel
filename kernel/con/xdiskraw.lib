;*******************************************************************************
; Local raw 8/9-sector floppy services, for maintenance tools under MXdisk.
; Function 35/36: the usual stack IOPB, TRACK=(head<<8)|cylinder, sector 0..8,
; count 1..9, confined to one head. Function 29: DSKMAINT variable-format
; IOPB, logical track 0..79, count 8/9, extra gap/fill word at BP+16.
; Legacy functions 10/11/15 retain eight-sector semantics. The explicit
; capability query on function 14 must precede any use of the new entries.
;*******************************************************************************
raw_code_start equ offset $
        cseg
        org raw_code_start
io_raw_read:
        mov raw_function,offset io_read
        jmps raw_disk_entry
io_raw_write:
        mov raw_function,offset io_write
raw_disk_entry:
        mov bp,sp
        cmp drive,1
        ja raw_disk_bad
        cmp byte ptr track,40
        jae raw_disk_bad
        cmp byte ptr track+1,1
        ja raw_disk_bad
        cmp sector,8
        ja raw_disk_bad
        xor ax,ax
        mov al,mcnt
        or al,al
        jz raw_disk_bad
        add ax,sector
        cmp ax,9
        ja raw_disk_bad
        xor ax,ax
        mov al,byte ptr track
        cmp byte ptr track+1,0
        je raw_disk_track
        neg ax
        add ax,79
raw_disk_track:
        mov track,ax
        mov raw_eot,9
        pop raw_return
        call raw_function
        mov raw_eot,8
        jmp raw_return
raw_disk_bad:
        mov ax,0401h
        ret

io_variable_format:
        mov bp,sp
        cmp drive,1
        ja raw_disk_bad
        cmp track,80
        jae raw_disk_bad
        cmp mcnt,8
        jb raw_disk_bad
        cmp mcnt,9
        ja raw_disk_bad
        mov al,mcnt
        mov raw_format_count,al
        mov ax,word ptr 16[bp]
        mov raw_gap_fill,ax
        pop raw_return
        call format_floppy
        mov raw_format_count,0
        jmp raw_return

raw_data_start equ offset $
        dseg
        org raw_data_start
raw_function dw 0
raw_return dw 0
raw_eot db 8
raw_format_count db 0
raw_gap_fill dw 0
