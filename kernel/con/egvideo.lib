; Preserve the combined XIOS code/data origin across library boundaries.
eg_reorg equ offset $
	cseg
	org eg_reorg

;------------------------------------------------------------------------------
; Enhanced graphics adapter bridge (local copy in each independent project).
;
; Native function 30 assigns 50h=10h, 60h=0Dh, 70h=0Eh,
; 80h=11h, 90h=12h, A0h=13h. A single foreground console owns graphics.
; Function 31 accepts the usual packet AX,BX,CX,DX,console (nine bytes).
; Set bit 7 of its BIOS selector to use a packet also for cursor/cell/TTY
; operations. Plain selectors retain the historical native argument ABI.
; Firmware runs through video_bios with IRQs masked and a private stack.
; CF=0: handled, AX=result; CF=1: ordinary text/CGA path, inputs unchanged.
;------------------------------------------------------------------------------
eg_native_video:
	call	eg_try_video
	jnc	$+5
	mov	ax,0FFFFh
	ret

eg_try_video:
	push	bx ! push cx ! push dx ! push si
	push	di ! push bp ! push es ! push ax
	call	eg_dispatch
	jc	$+5
	jmp	eg_handled
	pop	ax
	pop	es ! pop bp ! pop di ! pop si
	pop	dx ! pop cx ! pop bx
	stc
	ret
eg_handled:
	add	sp,2
	pop	es ! pop bp ! pop di ! pop si
	pop	dx ! pop cx ! pop bx
	clc
	ret

eg_dispatch:
	push	ax
	and	al,7Fh
	cmp	al,1
	jb	eg_selector_bad
	cmp	al,16
	ja	eg_selector_bad
	cmp	al,4
	je	eg_selector_bad
	cmp	al,5
	je	eg_selector_bad
	cmp	al,15
	je	eg_selector_bad
	pop	ax
	jmp	eg_selector_ok
eg_selector_bad:
	pop	ax
	test	al,80h
	jz	$+5
	jmp	eg_reject
	stc
	ret
eg_selector_ok:
	xor	ah,ah
	mov	si,ax			; BIOS selector, optionally packet flag
	test	al,80h
	jz	$+5
	jmp	eg_packet
	cmp	al,16
	jne	$+5
	jmp	eg_packet
	cmp	al,6
	jae	$+5
	jmp	eg_simple
	cmp	al,8
	jne	$+5
	jmp	eg_simple
	cmp	al,14
	jne	$+5
	jmp	eg_simple
	cmp	al,13
	jbe	$+5
	jmp	eg_fallback
eg_packet:
	mov	es,cx
	mov	di,dx
	mov	dl,es:byte ptr 8[di]
	eg_simple:
	cmp	dl,num_vir_cons
	jb	$+5
	jmp	eg_reject
	call	point_vs
	cmp	vs_screen_mode,50h
	jae	$+5
	jmp	eg_fallback
	cmp	vs_screen_mode,0A0h
	jbe	$+5
	jmp	eg_reject
	cmp	bios_graphics,0
	jne	$+5
	jmp	eg_reject
	mov	al,vs_number
	cmp	al,top_screen
	je	$+5
	jmp	eg_reject
	mov	al,vs_bit
	test	graphic_bits,al
	jnz	$+5
	jmp	eg_reject
	call	get_mx
	push	cx
	call	eg_owned
	pop	cx
	mov	vs_mx,0
	clc
	ret

eg_fallback:
	test	si,80h
	jz	$+5
	jmp	eg_reject
	stc
	ret
eg_reject:
	mov	ax,0FFFFh
	clc
	ret

; Work only after locking the graphics owner. Dimensions also bound BIOS
; character rectangles. Mode 13h uses 8x8 cells; VGA 480 uses 8x16;
; mode 10h uses 8x14. Reject nonzero pages and malformed rectangles.
eg_owned:
	mov	bp,200
	mov	cx,640
	cmp	vs_screen_mode,50h
	je	$+5
	jmp	eg_not_350
	mov	bp,350
eg_not_350:
	cmp	vs_screen_mode,80h
	jae	$+5
	jmp	eg_not_480
	mov	bp,480
eg_not_480:
	cmp	vs_screen_mode,60h
	jne	$+5
	jmp	eg_narrow
	cmp	vs_screen_mode,0A0h
	je	$+5
	jmp	eg_dimensions
	mov	bp,200
eg_narrow:
	mov	cx,320
eg_dimensions:
	test	si,80h
	jz	$+5
	jmp	eg_owned_packet
	cmp	si,16
	jne	$+5
	jmp	eg_owned_packet
	cmp	si,6
	jae	$+5
	jmp	eg_owned_simple
	cmp	si,8
	jne	$+5
	jmp	eg_owned_simple
	cmp	si,14
	jne	$+5
	jmp	eg_owned_simple
eg_owned_packet:
	and	si,7Fh
	cmp	si,16
	jne	$+5
	jmp	eg_palette
	cmp	si,12
	jne	$+5
	jmp	eg_pixel
	cmp	si,13
	jne	$+5
	jmp	eg_pixel
	; Derive character bounds from pixel dimensions and ROM font height.
	shr	cx,1 ! shr cx,1 ! shr cx,1
	mov	ax,25
	cmp	bp,480
	je	$+5
	jmp	eg_cell_bounds
	mov	ax,30
eg_cell_bounds:
	cmp	si,6
	jne	$+5
	jmp	eg_rectangle
	cmp	si,7
	jne	$+5
	jmp	eg_rectangle
	cmp	es:byte ptr 3[di],0
	je	$+5
	jmp	eg_owned_bad
	cmp	si,2
	je	$+5
	jmp	eg_packet_call
	cmp	es:byte ptr 6[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],al
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_rectangle:
	cmp	es:byte ptr 4[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 6[di],cl
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 5[di],al
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],al
	jb	$+5
	jmp	eg_owned_bad
	mov	ax,es:word ptr 4[di]
	cmp	al,es:byte ptr 6[di]
	jbe	$+5
	jmp	eg_owned_bad
	cmp	ah,es:byte ptr 7[di]
	jbe	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_pixel:
	cmp	es:byte ptr 3[di],0
	je	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 4[di],cx
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 6[di],bp
	jb	$+5
	jmp	eg_owned_bad
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_chain4_pixel
	jmp	eg_packet_call

eg_palette:
	mov	al,es:byte ptr [di]
	cmp	al,0
	jne	$+5
	jmp	eg_atc_write
	cmp	al,7
	jne	$+5
	jmp	eg_atc_read
	cmp	enhanced_vga,0
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:word ptr 2[di],256
	jb	$+5
	jmp	eg_owned_bad
	cmp	al,15h
	jne	$+5
	jmp	eg_packet_call
	cmp	al,10h
	je	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 5[di],64
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 4[di],64
	jb	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 7[di],64
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call
eg_atc_write:
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr 3[di],64
	jb	$+5
	jmp	eg_owned_bad
eg_atc_read:
	cmp	vs_screen_mode,0A0h
	jne	$+5
	jmp	eg_owned_bad
	cmp	es:byte ptr [di],7
	jne	eg_atc_index
	cmp	enhanced_vga,0
	jne	$+5
	jmp	eg_owned_bad
eg_atc_index:
	cmp	es:byte ptr 2[di],16
	jb	$+5
	jmp	eg_owned_bad
	jmp	eg_packet_call

eg_owned_bad:
	mov	ax,0FFFFh
	ret

; Preserve the screen pointer across ROM calls. Results are captured by
; the existing guarded helper before it restores caller registers.
eg_packet_call:
	push	bx
	mov	ax,si
	mov	ah,al
	mov	al,es:byte ptr [di]
	mov	bx,es:word ptr 2[di]
	mov	cx,es:word ptr 4[di]
	mov	dx,es:word ptr 6[di]
	call	video_bios
	pop	bx
	cmp	si,3
	jne	$+5
	jmp	eg_packet_results
	cmp	si,16
	je	$+5
	jmp	eg_pixel_result
eg_packet_results:
	mov	ax,video_result_bx
	mov	es:word ptr 2[di],ax
	mov	ax,video_result_cx
	mov	es:word ptr 4[di],ax
	mov	ax,video_result_dx
	mov	es:word ptr 6[di],ax
eg_pixel_result:
	cmp	si,8
	jne	$+5
	jmp	eg_read_result
	cmp	si,13
	jne	$+5
	jmp	eg_read_result
	xor	ax,ax
	ret
eg_read_result:
	mov	ax,video_result_ax
	ret

; Historical native simple ABI: CX holds cursor argument or TTY byte;
; DL is console. Native TTY uses white (15); full packets preserve BL.
eg_owned_simple:
	push	bp
	mov	bp,sp
	mov	cx,ss:word ptr 4[bp] ; saved before the dimension calculation
	pop	bp
	push	bx
	xor	bx,bx
	mov	ax,si
	mov	ah,al
	cmp	si,2
	je	$+5
	jmp	eg_simple_tty
	mov	dx,cx
eg_simple_tty:
	cmp	si,14
	je	$+5
	jmp	eg_simple_call
	mov	al,cl
	mov	bl,15
eg_simple_call:
	call	video_bios
	pop	bx
	cmp	si,3
	je	$+5
	jmp	eg_simple_read
	mov	ax,video_result_dx
	ret
eg_simple_read:
	jmp	eg_read_result

; VGA mode 13h uses a linear chain-4 byte, with no XOR interpretation.
; Establish ordinary write mode temporarily, restoring GC/SEQ registers and
; their index selectors afterwards. All eight colour bits are retained.
eg_chain4_pixel:
	push	bx ! push es ! push si
	mov	ax,es:word ptr 6[di]
	mov	bx,320
	mul	bx
	add	ax,es:word ptr 4[di]
	mov	cl,es:byte ptr [di]
	mov	di,ax
	mov	ax,0A000h
	mov	es,ax
	mov	dx,3C4h
	in	al,dx
	xor	ah,ah
	push	ax			; original sequencer index
	mov	al,2
	out	dx,al
	inc	dx
	in	al,dx
	push	ax			; original map mask
	mov	al,0Fh
	out	dx,al
	mov	dx,3CEh
	in	al,dx
	push	ax			; original graphics-controller index
	mov	si,offset eg_chain4_regs
	mov	bh,4
eg_chain4_save:
	lodsb
	out	dx,al
	inc	dx
	in	al,dx
	push	ax
	mov	al,cs:byte ptr [si]
	inc	si
	out	dx,al
	dec	dx
	dec	bh
	jnz	eg_chain4_save
	; Saved SI is the original operation selector (12=write, 13=read).
	push	bp
	mov	bp,sp
	cmp	ss:word ptr 16[bp],13
	pop	bp
	je	eg_chain4_read
	mov	es:byte ptr [di],cl
	xor	cx,cx
	jmp	eg_chain4_restore
eg_chain4_read:
	xor	cx,cx
	mov	cl,es:byte ptr [di]
eg_chain4_restore:
	mov	si,offset eg_chain4_regs+6
	mov	bh,4
eg_chain4_restore_loop:
	mov	al,cs:byte ptr [si]
	out	dx,al
	inc	dx
	pop	ax
	out	dx,al
	dec	dx
	sub	si,2
	dec	bh
	jnz	eg_chain4_restore_loop
	pop	ax			; graphics-controller index
	out	dx,al
	mov	dx,3C5h
	pop	ax			; sequencer map mask
	out	dx,al
	dec	dx
	pop	ax			; sequencer index
	out	dx,al
	mov	ax,cx
	pop	si ! pop es ! pop bx
	ret
; Graphics enable-set/reset, rotate, write/read mode, bit mask. Chain-4
; mode remains BIOS configured; GC mode 40h retains its 256-colour shift.
eg_chain4_regs db 1,0,3,0,5,40h,8,0FFh

; Native CGA programs hardware directly. Keep the ROM's BIOS data area
; in agreement so its pixel writer distinguishes mode 6 from modes 4/5.
; AL=BIOS mode, AH=columns. Also reset the single exposed page offset.
eg_legacy_bda:
	push	ax ! push bx ! push es
	mov	bx,40h
	mov	es,bx
	mov	es:byte ptr .49h,al
	mov	es:byte ptr .4Ah,ah
	mov	es:byte ptr .4Bh,0
	mov	es:word ptr .4Eh,0
	mov	es:byte ptr .62h,0
	mov	bx,800h
	cmp	al,2
	jb	eg_bda_page_size
	mov	bx,1000h
	cmp	al,4
	jb	eg_bda_page_size
	mov	bx,4000h
eg_bda_page_size:
	mov	es:word ptr .4Ch,bx
	pop	es ! pop bx ! pop ax
	ret

; Capability-gated native mode handlers. CH remains the requested native
; mode through general_graph's foreground wait and text-image capture.
eg_320_200:
	cmp	enhanced_video,0
	jne	$+5
	jmp	eg_mode_unsupported
	mov	al,0Dh
	jmp	eg_mode_begin
eg_640_200:
	cmp	enhanced_video,0
	jne	$+5
	jmp	eg_mode_unsupported
	mov	al,0Eh
	jmp	eg_mode_begin
eg_vga_mono:
	mov	al,11h
	jmps	eg_vga_mode
eg_vga_color:
	mov	al,12h
	jmps	eg_vga_mode
eg_vga_256:
	mov	al,13h
eg_vga_mode:
	cmp	enhanced_vga,0
	jne	$+5
	jmp	eg_mode_unsupported
eg_mode_begin:
	push	ax
	call	general_graph
	pop	ax
	jmp	enhanced_graph_init
eg_mode_unsupported:
	jmp	screen_not_sup

; Immutable map used by both native mode query and DOS mode translation.
eg_bios_modes db 10h,0Dh,0Eh,11h,12h,13h
enhanced_vga db 0
video_result_ax dw 0
video_result_bx dw 0
video_result_cx dw 0
video_result_dx dw 0
