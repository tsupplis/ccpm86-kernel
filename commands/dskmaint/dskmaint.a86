;*****************************************************************************
;
;	DSKMAINT - Concurrent CP/M-86 3.1 disk maintenance, version 1.5
;	Digital Research, 26 January 1984. Maintained native-format edition.
;	DSKMORG retains the byte-exact historical reconstruction.
;
;	CODE/DATA, loader-allocated EXTRA and a 256-byte STACK are separate.
;	XIOS disk I/O is protected by MXdisk, P_KEEP and console state checks.
;	Build and check: make check
;
;*****************************************************************************
; Loader base-page and published CCP/M/XIOS structure fields.
BP_EXTRA_BYTES equ 0ch
BP_EXTRA_HIGH equ 0eh
BP_EXTRA_SEG equ 0fh
BP_STACK_SEG equ 15h
SYSDAT_XIOS equ 28h
SYSDAT_CONSOLES equ 54h
SYSDAT_OPEN_FILES equ 88h
PROCESS_FLAGS equ 6
PROCESS_UDA equ 10h
CONSOLE_FLAGS equ 0eh
CONSOLE_BYTES equ 2ch
UDA_ERROR_MODE equ 10h
DPH_MEDIA_STATE equ 6
DPH_DPB equ 8
DPB_BLOCK_MASK equ 3
DPB_MAX_BLOCK equ 5
DPB_RESERVED equ 13
DPB_SECTOR_SHIFT equ 15
BOOT_MARKER equ 01ffh
BOOT_HEADS equ 01feh
BOOT_LOADER equ 0900h

	cseg
	org	0
entry:
	jmps	main
	db	'Copyright (C) 1983, Digital Research, Inc.Serial No. 2004-0000-654321'

;-----------------------------------------------------------------------------
; Use loader DATA, EXTRA and STACK groups; acquire process/console/disk locks.
;-----------------------------------------------------------------------------
main:
	cli
	mov	ss,word ptr .BP_STACK_SEG
	mov	sp,0100h
	sti
	mov	ax,ds
	mov	es,ax
	mov	word ptr output_segment,ax
	call	check_version
	call	get_os_data
	call	init_buffers
	call	set_priority
	call	keep_process
	call	lock_console
	jz	console_error
	call	lock_disk
	jz	open_file_error
	call	set_error_mode
	call	check_console
	call	draw_frame
main_menu:
	mov	si,offset main_menu_record
	call	show_menu
	shl	bx,1
	call	word ptr menu_handlers[bx]
	call	clear_window
	jmps	main_menu

;-----------------------------------------------------------------------------
; Restore display, release disk/console locks, clear P_KEEP and terminate.
;-----------------------------------------------------------------------------
exit_program:
	call	restore_screen
cleanup_exit:
	call	invalidate_drives
	call	restore_error_mode
	call	unlock_disk
	call	unlock_console
	call	release_process
	xor	cx,cx
	xor	dx,dx
	jmp	bdos
startup_error:
	push	si
	call	restore_screen
	pop	si
	call	write_buffer
	jmps	cleanup_exit
console_error:
	mov	si,offset msg_background
	jmps	startup_error
open_file_error:
	mov	si,offset msg_open_files
	jmps	startup_error

;-----------------------------------------------------------------------------
; Require the Concurrent/MPM OS family and CCP/M 3.1 version 1431h.
;-----------------------------------------------------------------------------
check_version:
	mov	cx,0ch
	int	byte ptr 0e0h
	and	ah,0fh
	cmp	ah,04h
	jz	check_ccpm_version
	cmp	ah,06h
	jnz	wrong_version
check_ccpm_version:
	mov	cx,0a3h
	int	byte ptr 0e0h
	cmp	ax,01431h
	jnz	wrong_version
	ret
wrong_version:
	mov	dx,offset msg_version
	mov	cx,09h
	int	byte ptr 0e0h
	xor	cx,cx
	xor	dx,dx
	int	byte ptr 0e0h
copy_menu:
	mov	word ptr action_caption,offset copy_text
	mov	word ptr drive_prompt,offset source_prompt
	mov	si,offset drive_menu_record
	call	drive_menu
	jz	copy_return
	call	select_source
	jz	copy_bad_disk
	mov	word ptr drive_prompt,offset target_prompt
	mov	si,offset drive_menu_record
	call	drive_menu
	jz	copy_return
	call	select_target
	jz	copy_bad_disk
	call	compare_dpbs
	jnz	copy_confirm
	mov	si,offset mismatch_caption
	jmps	copy_error
copy_confirm:
	call	confirm_copy
	jz	copy_menu
	call	copy_batches
	jmps	copy_menu
copy_return:
	ret
copy_bad_disk:
	mov	si,offset msg_bad_disk
copy_error:
	mov	word ptr error_caption,si
	mov	si,offset error_record
	call	show_menu
	jmps	copy_menu
copy_batches:
	call	size_buffers
	call	reset_track
	mov	word ptr io_function,0ah
	call	prompt_source
copy_next_batch:
	call	save_batch
	mov	cl,byte ptr source_drive
	call	read_batch
	jz	disk_error
	cmp	al,03h
	jz	copy_done
	push	ax
	call	prompt_target
	call	restore_batch
	mov	cl,byte ptr target_drive
	call	write_batch
	jz	copy_failed
	cmp	al,03h
	jnz	copy_check_batch
	pop	ax
	jmp	copy_done
copy_check_batch:
	call	restore_batch
	mov	cl,byte ptr target_drive
	call	check_batch
	jz	copy_failed
	inc	word ptr io_track
	pop	ax
	cmp	al,02h
	jz	copy_done
	cmp	al,03h
	jz	copy_done
	call	prompt_source
	jmp	copy_next_batch
copy_done:
	ret
copy_failed:
	pop	cx
disk_error:
	mov	si,offset msg_bad_disk
	mov	word ptr error_caption,si
	mov	si,offset error_record
	call	show_menu
	ret
reset_track:
	mov	word ptr io_track,00h
	ret
format_single:
	mov	si,offset profile160
	jmps	choose_format
format_double:
	mov	si,offset profile320
	jmps	choose_format
format_720:
	mov	si,offset profile720
	jmps	choose_format
format_1200:
	mov	si,offset profile1200
	jmps	choose_format
format_1440:
	mov	si,offset profile1440
choose_format:
; Profile: caption, logical tracks, sectors, marker, gap/fill.
	lodsw
	mov	action_caption,ax
	lodsw
	mov	format_tracks,ax
	lodsb
	mov	byte ptr sectors_per_track,al
	lodsb
	mov	sides,al
	lodsw
	mov	format_gap,ax
	call	select_profile
	cmp	byte ptr native_io,0
	je	format_menu
	xor	cx,cx
	mov	dx,444bh
	mov	si,534ch
	mov	al,14
	call	xios_call
	cmp	ax,4b44h
	jne	unsupported_format
	cmp	dx,0102h
	je	format_menu
unsupported_format:
	mov	word ptr error_caption,offset unsupported_caption
	mov	si,offset error_record
	call	show_menu
	ret
format_menu:
	mov	word ptr drive_prompt,offset format_prompt
	mov	si,offset drive_menu_record
	call	drive_menu
	jz	format_return
	xor	bh,bh
	mov	bl,drive_numbers[bx]
	mov	byte ptr source_drive,bl
	add	bl,041h
	mov	byte ptr confirm_drive_letter,bl
	mov	byte ptr format_drive_letter,bl
	call	confirm_format
	jz	format_return
	call	format_disk
	jmps	format_menu
format_return:
	ret

;-----------------------------------------------------------------------------
; Legacy function 15 / extended 29 format tracks, then write and verify boot data.
;-----------------------------------------------------------------------------
format_disk:
	mov	ax,buffer_start
	mov	io_segment,ax
	mov	word ptr io_offset,0
	mov	cx,word ptr format_tracks
	mov	word ptr io_function,0fh
	mov	word ptr track_caption,offset formatting_record
	mov	word ptr io_track,00h
	mov	al,byte ptr source_drive
	mov	byte ptr io_drive,al
format_next_track:
	push	cx
	call	check_abort
	jnz	format_track
	pop	cx
	inc	al
	jmp	verify_done
format_track:
	call	show_track
	call	xios_request
	pop	cx
	or	al,al
	jnz	format_failed
	inc	word ptr io_track
	loop	format_next_track
	mov	word ptr io_track,00h
	mov	word ptr io_function,0ah
	call	write_boot_track
	or	al,al
	jnz	format_failed
	mov	ax,word ptr format_tracks
	dec	ax
	mov	word ptr last_track,ax
	mov	al,byte ptr sectors_per_track
	mov	io_count,al
	jmp	verify_disk
format_failed:
	jmp	disk_error

;-----------------------------------------------------------------------------
; E5 fill, shared boot code at 0, side flag at 1FFh and shared loader at 900h.
;-----------------------------------------------------------------------------
write_boot_track:
	push	es
	mov	ax,buffer_start
	mov	es,ax
	mov	word ptr io_segment,ax
	xor	di,di
	mov	al,0e5h
	mov	cx,01000h
	rep	stosb
	xor	di,di
	mov	si,offset bootsect
	mov	cx,offset bootend-offset bootsect
	rep	movsb
	mov	al,byte ptr sides
	mov	es:byte ptr .BOOT_MARKER,al
	cmp	byte ptr native_io,0
	je	boot_marker_ready
	mov	es:byte ptr .BOOT_HEADS,1
boot_marker_ready:
	mov	di,BOOT_LOADER
	mov	si,offset loader
	mov	cx,offset loadend-offset loader
	rep	movsb
	mov	cl,byte ptr source_drive
	mov	byte ptr io_drive,cl
	xor	ax,ax
	mov	word ptr io_track,ax
	mov	word ptr io_sector,ax
	mov	word ptr io_offset,ax
	mov	word ptr io_function,0bh
	mov	byte ptr io_count,08h
	mov	si,offset writing_record
	mov	word ptr track_caption,si
	call	show_track
	call	xios_request
	pop	es
	ret
verify_menu:
	mov	word ptr action_caption,offset verify_text
	mov	word ptr drive_prompt,offset verify_prompt
	mov	si,offset drive_menu_record
	call	drive_menu
	jz	verify_return
	call	select_source
	jnz	verify_start
	jmp	verify_failed
verify_start:
	call	size_buffers
	call	save_batch
	mov	word ptr io_track,00h
	call	clear_window
	mov	al,byte ptr confirm_drive_letter
	mov	byte ptr verify_drive_letter,al
	mov	si,offset verify_list
	mov	bx,02h
	call	draw_record
	call	verify_disk
	jmps	verify_menu
verify_return:
	ret

;-----------------------------------------------------------------------------
; Read each track through XIOS so the controller checks its CRCs.
;-----------------------------------------------------------------------------
verify_disk:
	xor	ax,ax
	mov	word ptr saved_track,ax
	mov	word ptr io_track,ax
	mov	ax,0ah
	mov	word ptr io_function,ax
	mov	cl,byte ptr source_drive
	mov	byte ptr io_drive,cl
	call	select_known_disk
	jz	verify_failed
	mov	si,offset checking_record
	mov	word ptr track_caption,si
verify_next_track:
	call	check_abort
	jz	verify_done
	call	show_track
	call	xios_request
	or	al,al
	jnz	verify_failed
	mov	ax,word ptr io_track
	inc	ax
	cmp	ax,word ptr last_track
	ja	verify_done
	mov	word ptr io_track,ax
	jmps	verify_next_track
verify_done:
	ret
verify_failed:
	jmp	disk_error
check_batch:
	mov	ax,0ah
	mov	si,offset checking_record
	jmps	transfer_batch
read_batch:
	mov	ax,0ah
	mov	si,offset reading_record
	jmps	transfer_batch
write_batch:
	mov	ax,0bh
	mov	si,offset writing_record
transfer_batch:
	mov	word ptr buffer_index,00h
	mov	word ptr io_function,ax
	mov	word ptr track_caption,si
	mov	byte ptr io_drive,cl
	call	select_known_disk
	jz	transfer_failed
transfer_next_track:
	call	show_track
	call	xios_request
	or	al,al
	jnz	transfer_failed
	call	check_abort
	jnz	transfer_advance
	inc	al
	mov	al,03h
	jmps	transfer_done
transfer_advance:
	call	advance_buffer
	jz	transfer_next_track
transfer_done:
	ret
transfer_failed:
	mov	si,offset error_record
	xor	al,al
	ret

;-----------------------------------------------------------------------------
; Stack IOPB: drive/count, track, sector, DMA segment, DMA offset. DS=SYSDAT, ES=UDA.
;-----------------------------------------------------------------------------
xios_request:
	push	bp
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	es
	push	ds
	cmp	word ptr io_function,10
	je	request_readonly
	mov	bx,1
	mov	cl,io_drive
	shl	bx,cl
	or	changed_drives,bx
request_readonly:
	cmp	byte ptr native_io,0
	je	request_gap
	cmp	word ptr io_function,15
	jne	request_gap
	call	make_ids
request_gap:
; Always reserve six words; legacy XIOS consumes only the first five.
	push	word ptr format_gap
request_iopb:
	mov	cl,io_drive
	mov	ch,io_count
	push	cx
	mov	cx,io_track
	cmp	byte ptr native_io,0
	je	request_track
	cmp	word ptr io_function,15
	je	request_track
	call	track_chs
request_track:
	push	cx
	mov	cx,io_sector
	cmp	byte ptr native_io,0
	je	request_sector
	mov	ch,byte ptr sectors_per_track
request_sector:
	push	cx
	push	word ptr io_segment
	push	word ptr io_offset
	mov	ax,io_function
	cmp	byte ptr native_io,0
	je	request_dispatch
	cmp	al,15
	jne	request_raw
	mov	al,29
	jmps	request_dispatch
request_raw:
	add	al,25
request_dispatch:
	mov	es,uda_segment
	mov	ds,system_segment
	callf	dword ptr .SYSDAT_XIOS
	add	sp,12
	pop	ds
	pop	es
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	pop	bp
	cld
	ret

; CX logical track -> CH head, CL cylinder, reversed on side one.
track_chs:
	xor	ch,ch
	cmp	cl,cylinders
	jb	track_chs_done
	mov	ch,cylinders
	add	ch,ch
	dec	ch
	sub	ch,cl
	mov	cl,ch
	mov	ch,1
track_chs_done:
	ret

; Extended XIOS format consumes caller-owned CHRN descriptors.
make_ids:
	mov	cx,io_track
	call	track_chs
	mov	dx,cx
	mov	es,io_segment
	mov	di,io_offset
	mov	bx,0201h
	xor	cx,cx
	mov	cl,byte ptr sectors_per_track
	mov	io_count,cl
	cld
ids_next:
	mov	ax,dx
	stosw
	mov	ax,bx
	stosw
	inc	bx
	loop	ids_next
	ret

advance_buffer:
	mov	ax,word ptr io_track
	inc	ax
	cmp	ax,word ptr last_track
	ja	buffer_disk_end
	mov	bx,ax
	mov	word ptr io_offset,00h
	mov	ax,word ptr io_segment
	add	ax,word ptr track_paras
	mov	cx,ax
	mov	ax,word ptr buffer_index
	inc	ax
	cmp	ax,word ptr buffer_tracks
	ja	buffer_batch_end
	mov	word ptr buffer_index,ax
	mov	word ptr io_segment,cx
	mov	word ptr io_track,bx
	xor	al,al
	ret
buffer_batch_end:
	mov	al,01h
	ret
buffer_disk_end:
	mov	al,02h
	ret
save_batch:
	mov	ax,word ptr buffer_start
	mov	word ptr io_segment,ax
	mov	ax,word ptr io_track
	mov	word ptr saved_track,ax
	mov	word ptr buffer_index,00h
	ret
restore_batch:
	mov	ax,word ptr saved_track
	mov	word ptr io_track,ax
	mov	ax,word ptr buffer_start
	mov	word ptr io_segment,ax
	mov	word ptr buffer_index,00h
	ret

;-----------------------------------------------------------------------------
; Derive track and transfer-buffer sizes from the DPB and EXTRA group length.
;-----------------------------------------------------------------------------
size_buffers:
	mov	bx,offset source_dpb
	mov	ax,[bx]
	mov	sectors_per_track,ax
	mov	io_count,al
	call	select_profile
; Round allocation bytes up to a physical track, add reserved tracks, then
; convert the track count to its last index (OFF is two on large media).
	mov	ax,DPB_MAX_BLOCK[bx]
	inc	ax
	xor	cx,cx
	mov	cl,DPB_BLOCK_MASK[bx]
	inc	cx
	mul	cx
	push	ax
	mov	ax,[bx]
	mov	cl,DPB_SECTOR_SHIFT[bx]
	shl	ax,cl
	mov	cx,ax
	pop	ax
	add	ax,cx
	dec	ax
	xor	dx,dx
	div	cx
	add	ax,DPB_RESERVED[bx]
	dec	ax
	mov	last_track,ax
	mov	word ptr io_sector,0
	mov	word ptr io_offset,0
	ret

; Align each track buffer to 16K so even 18-sector DMA stays in one 64K page.
; EXTRA's 32K minimum guarantees one full slot after alignment. buffer_tracks
; is the last usable slot index, matching advance_buffer's existing contract.
init_buffers:
	mov	bx,word ptr .BP_EXTRA_SEG
	mov	ax,bx
	add	ax,03ffh
	and	ax,0fc00h
	mov	buffer_start,ax
	sub	ax,bx
	mov	cl,4
	shl	ax,cl
	mov	bx,ax
	mov	ax,word ptr .BP_EXTRA_BYTES
	xor	dx,dx
	mov	dl,byte ptr .BP_EXTRA_HIGH
	sub	ax,bx
	sbb	dx,0
	mov	bx,04000h
	div	bx
	dec	ax
	mov	buffer_tracks,ax
	mov	word ptr track_paras,0400h
	ret

select_profile:
	mov	byte ptr native_io,0
	mov	byte ptr cylinders,40
	cmp	byte ptr sectors_per_track,8
	je	profile_ready
	mov	byte ptr native_io,1
	mov	byte ptr cylinders,80
profile_ready:
	ret

select_source:
	mov	si,offset source_prompt_letter
	mov	di,offset source_dpb
	mov	dx,offset source_drive
	jmps	select_argument
select_target:
	mov	si,offset target_prompt_letter
	mov	di,offset target_dpb
	mov	dx,offset target_drive
select_argument:
	xor	bh,bh
	mov	al,drive_numbers[bx]
	xchg	bx,dx
	mov	[bx],al
	mov	ah,al
	add	ah,041h
	mov	[si],ah
	mov	byte ptr confirm_drive_letter,ah
	mov	cl,al
	call	copy_dpb
	ret
copy_dpb:
	push	di
	call	select_new_disk
	pop	di
	or	bx,bx
	jz	dpb_done
	push	es
	mov	ax,ds
	mov	es,ax
	call	read_dpb
	pop	es
dpb_done:
	ret
select_new_disk:
	mov	dl,00h
select_disk:
	mov	al,09h
	call	xios_call
	or	bx,bx
	ret
select_known_disk:
	mov	dl,01h
	jmps	select_disk
read_dpb:
	push	ds
	mov	ds,word ptr system_segment
	mov	si,DPH_DPB[bx]
	mov	cx,011h
	rep	movsb
	pop	ds
	ret
confirm_copy:
	mov	si,offset copy_confirm_record
confirmation:
	push	si
	call	clear_and_menu
	cmp	al,04eh
	jz	confirmation_done
	cmp	al,06eh
	jz	confirmation_done
	cmp	al,059h
	jz	confirmation_yes
	cmp	al,079h
	jz	confirmation_yes
	call	beep
	pop	si
	jmps	confirmation
confirmation_yes:
	inc	al
confirmation_done:
	pop	si
	pushf
	mov	ax,0808h
	mov	cx,03h
	call	clear_rows
	popf
	ret
confirm_format:
	mov	si,offset format_confirm_record
	jmps	confirmation
show_track:
	mov	ax,02020h
	mov	bx,offset track_digits
	mov	[bx],ax
	inc	bx
	inc	bx
	mov	[bx],ax
	mov	ax,word ptr io_track
	mov	cx,04h
	mov	di,offset track_digits
	call	decimal
	mov	bx,02h
	mov	si,offset track_record
	call	draw_record
	ret
compare_dpbs:
	push	es
	mov	ax,ds
	mov	es,ax
	mov	si,offset source_dpb
	mov	di,offset target_dpb
	mov	cx,011h
	repe	cmpsb
	pop	es
	jnz	dpb_mismatch
	inc	al
	ret
dpb_mismatch:
	xor	al,al
	ret
prompt_source:
	mov	si,offset insert_source
	jmps	prompt_swap
prompt_target:
	mov	si,offset insert_target
prompt_swap:
	mov	al,byte ptr source_drive
	cmp	al,byte ptr target_drive
	jnz	swap_done
	mov	word ptr swap_prompt,si
	mov	si,offset swap_record
	call	show_menu
	mov	ax,0807h
	mov	cx,01h
	call	clear_rows
swap_done:
	ret
drive_menu:
	push	si
	call	clear_and_menu
drive_choice:
	pop	si
	mov	si,06h[si]
	add	si,02h
	mov	si,[si]
	inc	si
	cmp	byte ptr [bx+si],0c4h
	ret
redraw_drive_menu:
	push	si
	call	show_menu
	jmps	drive_choice

;-----------------------------------------------------------------------------
; XIOS function 14 supplies the installed drive list.
;-----------------------------------------------------------------------------
enumerate_drives:
	mov	al,0eh
	mov	cx,00h
	call	xios_call
	push	ds
	mov	ds,word ptr system_segment
	mov	ax,[bx]
	pop	ds
	mov	bx,ax
	inc	bx
	mov	si,offset drive_keys
	mov	[si],bx
	inc	si
	mov	cx,ax
	push	es
	mov	dx,ds
	mov	es,dx
	mov	di,offset available_keys
	xchg	si,di
	rep	movsb
	mov	byte ptr [di],0c4h
	pop	es
	shl	ax,1
	mov	si,offset drive_items
	mov	[si],bx
	inc	si
	inc	si
	add	si,ax
	mov	ax,offset drive_exit
	mov	[si],ax
	ret

;-----------------------------------------------------------------------------
; Far call through SYSDAT:28h with the process UDA in ES.
;-----------------------------------------------------------------------------
xios_call:
	push	ds
	push	es
	mov	es,word ptr uda_segment
	mov	ds,word ptr system_segment
	callf	dword ptr .SYSDAT_XIOS
	pop	es
	pop	ds
	ret
draw_frame:
	mov	al,0c4h
	mov	cx,04eh
	mov	di,offset border_line
	rep	stosb
	mov	si,offset top_frame
	mov	bx,00h
	call	draw_record
	mov	ax,0102h
	call	draw_side
	mov	ax,05002h
	call	draw_side
	mov	ax,0118h
	call	position_cursor
	mov	si,offset bottom_frame
	mov	bx,00h
	call	draw_record
	mov	si,offset title_record
	call	draw_caption
	mov	al,0cdh
	mov	di,offset divider_line
	mov	cx,04eh
	rep	stosb
	mov	si,offset divider_caption
	call	draw_caption
	ret
draw_side:
	mov	word ptr cursor_position,ax
	call	position_cursor
	mov	cx,016h
frame_side_row:
	push	cx
	mov	dl,0b3h
	mov	cl,02h
	call	bdos
	call	next_row
	pop	cx
	loop	frame_side_row
	ret
clear_and_menu:
	push	si
	call	clear_window
	pop	si
show_menu:
	mov	bx,06h
	call	draw_records
	xor	bx,bx
	mov	bl,byte ptr key_index
	mov	al,byte ptr key_value
	ret
draw_records:
	mov	word ptr record_limit,bx
	xor	bx,bx
draw_next_record:
	lodsw
	or	ax,ax
	jz	draw_record_done
	push	si
	push	bx
	mov	si,ax
	call	draw_record
	pop	bx
	pop	si
draw_record_done:
	cmp	bx,word ptr record_limit
	jz	draw_records_done
	inc	bx
	inc	bx
	jmps	draw_next_record
draw_records_done:
	ret
draw_record:
	lodsw
	mov	cx,ax
draw_record_item:
	push	cx
	push	bx
	lodsw
	push	si
	mov	si,ax
	call	word ptr draw_handlers[bx]
	pop	si
	pop	bx
	pop	cx
	loop	draw_record_item
	ret
draw_table:
	lodsw
	mov	word ptr cursor_position,ax
	push	si
	call	position_cursor
	pop	si
	call	draw_key_box
	lodsw
	mov	cx,ax
	lodsw
	mov	word ptr cursor_position,ax
	push	si
	push	cx
	call	position_cursor
	pop	cx
	pop	si
draw_table_text:
	push	cx
	lodsw
	mov	si,ax
	push	si
	call	write_buffer
	call	next_row
	pop	si
	pop	cx
	loop	draw_table_text
	ret
draw_key_box:
	mov	di,offset key_chars
	mov	cx,03h
	push	es
	mov	ax,ds
	mov	es,ax
	rep	movsb
	pop	es
	push	si
	mov	si,offset key_top
	call	write_buffer
	call	next_row
	mov	si,offset key_middle
	call	write_buffer
	call	next_row
	mov	si,offset key_bottom
	call	write_buffer
	pop	si
	ret
draw_caption:
	lodsw
	push	si
	call	position_cursor
	pop	si
	lodsw
	push	si
	mov	byte ptr video_mode,ah
	call	set_video
	pop	si
	mov	si,[si]
	call	write_buffer
	mov	al,byte ptr video_mode
	call	set_video
	ret
read_menu_key:
	xor	ax,ax
	lodsb
	mov	word ptr key_count,ax
	xchg	si,di
menu_wait_key:
	push	di
	push	di
	call	get_key
	mov	byte ptr key_value,al
	mov	cx,word ptr key_count
	pop	di
	jcxz	menu_key_found
	repne	scasb
	jnz	menu_bad_key
menu_key_found:
	pop	di
	mov	ax,word ptr key_count
	sub	ax,cx
	dec	al
	mov	byte ptr key_index,al
	mov	bl,al
	mov	al,byte ptr key_value
	ret
menu_bad_key:
	call	beep
	pop	di
	jmps	menu_wait_key
clear_window:
	mov	ax,0204h
	mov	cx,014h
clear_rows:
	push	bx
	xor	bh,bh
	mov	bl,80
	sub	bl,ah
	mov	word ptr blank_line,bx
	pop	bx
	push	cx
	mov	word ptr cursor_position,ax
	call	position_cursor
	pop	cx
clear_next_row:
	push	cx
	mov	si,offset blank_line
	call	write_buffer
	call	next_row
	pop	cx
	loop	clear_next_row
	ret
next_row:
	inc	byte ptr cursor_position
	mov	ax,word ptr cursor_position
	call	position_cursor
	ret

;-----------------------------------------------------------------------------
; INT E0h entry; callers supply the function and parameters.
;-----------------------------------------------------------------------------
bdos:
	int	byte ptr 0e0h
	ret

;-----------------------------------------------------------------------------
; BDOS 111 outputs the length-prefixed text via a segmented buffer descriptor.
;-----------------------------------------------------------------------------
write_buffer:
	lodsw
	mov	word ptr output_length,ax
	mov	word ptr output_offset,si
	mov	cl,06fh
	mov	dx,offset output_offset
	jmp	bdos
write_string:
	mov	cl,09h
	mov	dx,si
	jmp	bdos
read_buffer:
	lodsw
	mov	word ptr input_length,ax
	mov	word ptr input_offset,si
	mov	cl,070h
	mov	dx,offset input_offset
	jmp	bdos
beep:
	mov	si,offset bell
	jmp	write_buffer
get_key:
	mov	dl,0fdh
	mov	cl,06h
	jmp	bdos
decimal:
	dec	di
	add	di,cx
	mov	bx,0ah
decimal_digit:
	sub	dx,dx
	div	bx
	add	dl,030h
	mov	[di],dl
	dec	di
	test	ax,ax
	jz	decimal_done
	loop	decimal_digit
decimal_done:
	ret
check_abort:
	mov	cl,0bh
	call	bdos
	or	al,al
	jz	no_abort
	call	get_key
	cmp	al,03h
	ret
no_abort:
	inc	al
	ret
set_priority:
	mov	dl,096h
	mov	cl,091h
	jmp	bdos

;-----------------------------------------------------------------------------
; Set P_KEEP so termination cannot bypass cleanup while global locks are held.
;-----------------------------------------------------------------------------
keep_process:
	mov	bx,word ptr process_offset
	push	ds
	mov	ds,word ptr system_segment
	or	word ptr PROCESS_FLAGS[bx],02h
	pop	ds
	ret
release_process:
	mov	bx,word ptr process_offset
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr PROCESS_FLAGS[bx],0fffdh
	pop	ds
	ret

;-----------------------------------------------------------------------------
; Require a foreground, unbuffered console; atomically set NOSWITCH.
;-----------------------------------------------------------------------------
lock_console:
	mov	bx,word ptr console_offset
	push	ds
	mov	ds,word ptr system_segment
	cli
	cmp	word ptr CONSOLE_FLAGS[bx],00h
	jz	console_available
	xor	ax,ax
	jmps	console_lock_done
console_available:
	or	word ptr CONSOLE_FLAGS[bx],08h
console_lock_done:
	sti
	pop	ds
	ret
unlock_console:
	mov	bx,word ptr console_offset
	push	ds
	mov	ds,word ptr system_segment
	and	word ptr CONSOLE_FLAGS[bx],0fff7h
	pop	ds
	ret

;-----------------------------------------------------------------------------
; Reject open files; open MXdisk and read its token to exclude filesystem I/O.
;-----------------------------------------------------------------------------
lock_disk:
	push	ds
	mov	ds,word ptr system_segment
	mov	ax,word ptr .SYSDAT_OPEN_FILES
	or	ax,ax
	pop	ds
	jnz	files_open
	mov	cl,087h
	mov	dx,offset disk_queue
	call	bdos
	mov	cl,089h
	mov	dx,offset disk_queue
	call	bdos
	xor	al,al
	inc	al
	ret
files_open:
	xor	ax,ax
	ret

;-----------------------------------------------------------------------------
; Return the MXdisk token before releasing console and process restrictions.
;-----------------------------------------------------------------------------
unlock_disk:
	mov	cl,08bh
	mov	dx,offset disk_queue
	call	bdos
	ret

;-----------------------------------------------------------------------------
; Fetch SYSDAT, process descriptor, UDA and this console control block.
;-----------------------------------------------------------------------------
get_os_data:
	push	es
	mov	cl,09ah
	call	bdos
	mov	word ptr system_segment,es
	mov	cl,09ch
	call	bdos
	mov	word ptr process_offset,bx
	mov	ax,es:PROCESS_UDA[bx]
	mov	word ptr uda_segment,ax
	mov	cl,099h
	call	bdos
	xor	ah,ah
	mov	byte ptr console_number,al
	mov	bx,CONSOLE_BYTES
	mul	bx
	add	ax,es:word ptr .SYSDAT_CONSOLES
	mov	word ptr console_offset,ax
	pop	es
	ret
; Clear XIOS login state for changed disks while MXdisk is still held.
; BDOS login is reset only after returning the mutex token.
invalidate_drives:
	xor	cx,cx
invalidate_next:
	mov	bx,1
	shl	bx,cl
	test	changed_drives,bx
	jz	invalidate_skip
	push	cx
	mov	dl,1
	call	select_disk
	or	bx,bx
	jz	invalidate_done
	push	ds
	mov	ds,system_segment
	mov	byte ptr DPH_MEDIA_STATE[bx],0
	pop	ds
invalidate_done:
	pop	cx
invalidate_skip:
	inc	cl
	cmp	cl,4
	jb	invalidate_next
	ret

set_error_mode:
	push	es
	mov	es,uda_segment
	mov	al,es:byte ptr .UDA_ERROR_MODE
	mov	old_error_mode,al
	mov	es:byte ptr .UDA_ERROR_MODE,0feh
	mov	byte ptr error_mode_held,1
	pop	es
	ret
restore_error_mode:
	cmp	byte ptr error_mode_held,0
	je	error_mode_done
	push	es
	mov	es,uda_segment
	mov	al,old_error_mode
	mov	es:byte ptr .UDA_ERROR_MODE,al
	pop	es
error_mode_done:
	ret

position_cursor:
	mov	si,offset cursor_bytes
	add	ax,01f1fh
	mov	[si],ax
	mov	si,offset cursor_sequence
	jmp	write_buffer
hide_cursor:
	mov	si,offset cursor_hide
	jmp	write_buffer
show_cursor:
	mov	si,offset cursor_show
	jmp	write_buffer
set_video:
	mov	si,offset video_codes
	xor	ah,ah
	add	si,ax
	mov	al,[si]
	mov	byte ptr video_attribute,al
	mov	si,offset video_sequence
	jmp	write_buffer
restore_screen:
	mov	si,offset restore_sequence
	jmp	write_buffer
check_console:
	mov	cl,099h
	call	bdos
	cmp	ax,04h
	jc	local_console
	mov	si,offset msg_terminal
	call	write_buffer
	xor	cx,cx
	xor	dx,dx
	jmp	cleanup_exit
local_console:
	mov	cl,06dh
	mov	dx,08eh
	call	bdos
	mov	si,offset init_sequence
	call	write_buffer
	call	enumerate_drives
	ret

;-----------------------------------------------------------------------------
; Symbolic menu records. Positions are one-based: low byte row, high byte column.
; Text is length-prefixed; no pointer depends on the embedded loader size.
