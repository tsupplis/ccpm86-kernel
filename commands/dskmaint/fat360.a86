;*****************************************************************************
; FAT360 - construct the FAT12 metadata for DFORM's DOS 360K profile.
; Raw format fills data with F6. Clear both metadata heads before writing:
; LBA 0 boot, 1..2 FAT1, 3..4 FAT2, 5..11 empty root (112 entries).
; Only LBA 0..17 are written here; the rest retain the format fill.
; No file allocation, system installation or FAT mounting is performed.
;*****************************************************************************
        cseg
write_fat360:
        mov dx,offset msg_writing_fat
        call puts
        call clear_fat_head
        mov si,offset fat_boot_sector
        xor di,di
        mov cx,512
        rep movsb
; FAT12 entries 0/1 are reserved: media FD, then FF FF. All others are free.
        mov es:word ptr .512,0fffdh
        mov es:byte ptr .514,0ffh
        mov es:word ptr .1536,0fffdh
        mov es:byte ptr .1538,0ffh
        mov track,0
        mov operation,3
        call disk_io
; DSKMAINT reverses logical head-one tracks: logical 79 is cylinder 0/head 1.
        call clear_fat_head
        mov al,track_count
        dec al
        mov track,al
        call disk_io
        ret
clear_fat_head:
        mov es,buffer_segment
        xor di,di
        xor ax,ax
        mov cx,2304
        cld
        rep stosw
        ret
        dseg
msg_writing_fat db 'Writing FAT12 boot sector, FATs and root directory...',13,10,'$'
        cseg
