; -----------------------------------------------------------------------------
; Load the current page title, choices and dispatch table, then draw its frame and help text.
; -----------------------------------------------------------------------------
showpage:
	mov	si,word ptr .page_title
	mov	dh,3h
	call	putcent
	mov	si,word ptr .field_0c65
	call	drawbuttons
	mov	si,item_0d13
	call	drawbuttons
	mov	si,item_0d4c
	mov	dx,item_1605
	call	putat
	mov	si,item_0c71
	mov	dh,5h
	jmp	revcent

; -----------------------------------------------------------------------------
; Draw the terminal frame using the stored corner and line descriptors.
; -----------------------------------------------------------------------------
drawframe:
	mov	si,item_0bc6
	call	puts
	mov	cx,4eh
	mov	dx,1h
	mov	bl,0c4h
	call	hline
	mov	dx,201h
	mov	bl,0cdh
	call	hline
	mov	dx,item_1701
	mov	bl,0c4h
	call	hline
	mov	cx,16h
	mov	dx,100h
	mov	bl,0b3h
	call	vline
	mov	dx,14fh
	mov	bl,0b3h
	call	vline
	mov	si,item_0bde
	mov	cx,6h

; -----------------------------------------------------------------------------
; Place each configured corner character.
; -----------------------------------------------------------------------------
cornloop:
	mov	al,59h
	call	escout
	lodsb
	add	al,20h
	call	put_character
	lodsb
	add	al,20h
	call	put_character
	lodsb
	call	put_character
	loop	cornloop
	mov	si,item_0bf0
	mov	dh,1h
	jmp	putcent

; -----------------------------------------------------------------------------
; Draw a counted horizontal run from the current cursor position.
; -----------------------------------------------------------------------------
hline:
	push	cx
	call	gotoxy

; -----------------------------------------------------------------------------
; Output one horizontal-frame character per iteration.
; -----------------------------------------------------------------------------
hlloop:
	mov	al,bl
	call	put_character
	loop	hlloop
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Draw a counted vertical run by advancing the row.
; -----------------------------------------------------------------------------
vline:
	push	cx
	push	dx

; -----------------------------------------------------------------------------
; Position and output the next vertical-frame character.
; -----------------------------------------------------------------------------
vlloop:
	call	gotoxy
	mov	al,bl
	call	put_character
	inc	dh
	loop	vlloop
	pop	dx
	pop	cx
	ret

; -----------------------------------------------------------------------------
; Locate the configuration storage, read its sector and validate the saved signature.
; -----------------------------------------------------------------------------
loadsettings:
	push	ds
	pop	es
	mov	dx,80h
	mov	cx,1h
	mov	bx,1660h
	mov	ax,201h
	call	disk_io
	jc	loc_073d
	cmp	word ptr .field_185e,0aa55h
	jnz	loc_073d
	mov	cx,4h
	mov	si,item_181e

; -----------------------------------------------------------------------------
; Scan the four MBR partition entries for a usable disk partition.
; -----------------------------------------------------------------------------
partscan:
	cmp	byte ptr 4h[si],0dbh
	jz	foundpart
	add	si,10h
	loop	partscan
	jmps	loc_073d

; -----------------------------------------------------------------------------
; Retain the selected partition CHS location for configuration-sector access.
; -----------------------------------------------------------------------------
foundpart:
	mov	ax,word ptr 2h[si]
	and	al,0c0h
	or	al,3h
