	push	cx
	push	dx
	push	si
	push	di
	push	es
	mov	dl,al
	mov	cl,ah
	int	0e0h
	cld
	pop	es
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	ret

