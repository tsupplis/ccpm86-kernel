item_11a0_storage	db	'TYPE ANY KEY TO CONTINUE'
	db	0h
	db	'      This option controls the Verify After Write feature of the XIOS'
	db	0h
	db	'Diskette software.  When enabled, the Diskette is verified after each'
	db	0h
	db	'write operation, with automatic retries for verification errors.  The'
	db	0h
	db	'Verify feature results in greater data security at the cost of speed.'
	db	0h,0h
item_12d2_storage	db	2h,0eh,14h
	db	'1 Enable Verify After Write'
	db	0h,11h,14h
