; -----------------------------------------------------------------------------
; Call XIOS function 0Eh and copy its twenty-byte parameter/pointer block locally.
; -----------------------------------------------------------------------------
get_xios_parameters:
	push	ds
	mov	al,0eh
	mov	cx,1h
	mov	es,word ptr .xios_segment
	mov	ds,word ptr .system_segment
